{
  "name": "cyber-portfolio-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Public REST API for the Cyber Portfolio",
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "npm run test:e2e",
    "test:e2e": "node test/run-e2e.cjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.0",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
